{{ 'instagram-gallery.css' | asset_url | stylesheet_tag }}

<div class="page-width section-{{ section.id }}-padding">
  <div
    class="instagram-gallery color-{{ section.settings.color_scheme }} global-section-radius"
    style="
      background: {{ section.settings.section_background }};
      padding:
        {{ section.settings.padding_top }}px
        {{ section.settings.padding_right }}px
        {{ section.settings.padding_bottom }}px
        {{ section.settings.padding_left }}px;
    "
  >
    <div class="instagram-gallery__header">
      <div class="instagram-gallery__title-wrapper">
        {% if section.settings.heading != blank %}
          <h2 class="instagram-gallery__title h2">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank %}
        <div class="instagram-gallery__button-wrapper">
          <a
            href="{{ section.settings.button_link }}"
            class="h6 button button--secondary instagram-gallery__button custom-section__button"
            {% if section.settings.button_link contains 'http' %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
            {{ section.settings.button_label }}
            {% render 'insta-icon' %}
          </a>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="instagram-gallery__grid">
        {% for block in section.blocks %}
          <div
            class="instagram-gallery__item"
            {{ block.shopify_attributes }}
          >
            <a
              href="{{ block.settings.instagram_link }}"
              class="instagram-gallery__link"
              {% if block.settings.instagram_link != blank %}
                target="_blank"
                rel="noopener"
              {% endif %}
            >
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'instagram-gallery__image',
                    alt: block.settings.image.alt
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'instagram-gallery__placeholder' }}
              {% endif %}

              <div class="instagram-gallery__overlay">
                <span class="instagram-gallery__icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="42"
                    height="42"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <rect
                      x="3"
                      y="3"
                      width="18"
                      height="18"
                      rx="5"
                      stroke="white"
                      stroke-width="2"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="4"
                      stroke="white"
                      stroke-width="2"
                    />
                    <circle
                      cx="17.5"
                      cy="6.5"
                      r="1"
                      fill="white"
                    />
                  </svg>
                </span>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Instagram Gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@K-CAPS"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "FOLLOW US"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20,
      "label": "Top"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20,
      "label": "Right"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20,
      "label": "Bottom"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20,
      "label": "Left"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Image border radius"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}